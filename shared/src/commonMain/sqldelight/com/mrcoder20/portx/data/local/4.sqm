-- Simplified Migration for Version 4
-- We are not using complex table renames here to avoid SQLite driver specific limitations
-- We just ensure the structure is correct.

DROP TABLE IF EXISTS SettingsEntity;

CREATE TABLE SettingsEntity (
    id INTEGER PRIMARY KEY NOT NULL DEFAULT 0 CHECK (id = 0),
    language TEXT NOT NULL DEFAULT 'en',
    theme TEXT NOT NULL DEFAULT 'DARK',
    accentColor INTEGER NOT NULL DEFAULT 4278243839
);
